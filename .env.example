# ---------------------------------------------------------------------------
# HR_management_system — copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=django-insecure-HYWXUQ5blxl9zle9BouCEH3TwhMJtm9aoEXgap_I6VEUkEZ_X9hMCohQtoX8pdQmP-8
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_SETTINGS_MODULE=config.settings

# --- Published host ports -------------------------------------------------
# Only affect what docker publishes on YOUR machine; container-to-container
# traffic always uses the standard ports. Shifted by default so the stack
# starts even when a local postgres/redis/dev-server already owns 5432/6379/8000.
POSTGRES_HOST_PORT=5440
REDIS_HOST_PORT=6390
BACKEND_HOST_PORT=8010
FRONTEND_HOST_PORT=3000

# --- Database (PostgreSQL 16) --------------------------------------------
POSTGRES_DB=hrms
POSTGRES_USER=hrms
POSTGRES_PASSWORD=hrms
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://hrms:hrms@db:5432/hrms

# --- Redis (cache + celery broker/result) ---------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Locale / time --------------------------------------------------------
TIME_ZONE=Africa/Cairo
LANGUAGE_CODE=ar

# --- CORS / CSRF / cookies ------------------------------------------------
FRONTEND_ORIGIN=http://localhost:3000
# :3100 is the port the Playwright suite serves its own production build on.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3100
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_DOMAIN=

# --- Email (phase 4; SMTP works with Brevo / Mailgun / SES) ---------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com

# --- Frontend -------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8010
# Server-side (inside docker network) URL the Next.js server uses.
INTERNAL_API_URL=http://backend:8000
